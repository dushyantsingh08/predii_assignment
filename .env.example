# Copy to .env and fill in what you use. Everything is optional: with no keys the
# pipeline still works using the deterministic table parser.

SPECX_PDF=data/service-manual.pdf
SPECX_CACHE=.specx_cache

# Embeddings: sentence-transformers (default, local) | openai | tfidf (offline, no download)
SPECX_EMBED_BACKEND=sentence-transformers
SPECX_EMBED_MODEL=BAAI/bge-small-en-v1.5

# LLM: auto picks Anthropic if ANTHROPIC_API_KEY is set, else OpenAI if OPENAI_API_KEY is set, else none
SPECX_LLM_PROVIDER=auto
# SPECX_LLM_MODEL=gpt-4o-mini
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...

# Any OpenAI-compatible server (Ollama / Groq / vLLM):
# SPECX_LLM_PROVIDER=openai
# SPECX_LLM_BASE_URL=http://localhost:11434/v1
# SPECX_LLM_MODEL=llama3.1:8b
